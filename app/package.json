{
  "name": "lagang-launcher",
  "productName": "La Gang",
  "version": "0.1.1",
  "description": "Launcher de La Gang",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "@xmcl/yauzl": "2.10.0",
    "@xmcl/installer": {
      "undici": "6.29.1"
    },
    "@xmcl/file-transfer": {
      "undici": "6.29.1"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "build": {
    "appId": "lat.lagang.launcher",
    "productName": "La Gang",
    "copyright": "La Gang",
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "La Gang",
      "artifactName": "LaGang-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
